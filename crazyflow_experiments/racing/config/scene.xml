<mujoco model="Drone scene">
    <option integrator="RK4" density="1.225" viscosity="1.8e-5" timestep="0.001"/>
    <compiler inertiafromgeom="false" meshdir="assets" autolimits="true"/>
    <statistic center="0 0 2" extent="2.5"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.5 0.5 0.5" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 0" fog="1 1 1 0"/>
        <map fogstart="0" fogend="0"/>
        <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
        <quality offsamples="8"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1.0 1.0 1.0" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.3 0.3 0.3" rgb2="0.3 0.3 0.3"
        markrgb="0.1 0.1 0.1" width="512" height="512"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 1" reflectance="0.0"/>
        <material name="matte_white" rgba="0.9 0.9 0.9 1" specular="0" shininess="0" reflectance="0"/>
        <material name="softbox_fabric" rgba="1 1 1 1" emission="1" specular="0" shininess="0"/>
    </asset>

    <worldbody>
        <!-- Room -->
        <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
        <geom name="white_wall" type="box" pos="0 2.8 1.5" size="3 0.01 1.5" material="matte_white"/>
        <!-- Cameras -->
        <camera name="pixel8_cam" pos="0 -2 1.38" euler="85 0 0" fovy="40"/>
        <camera name="lumix_cam" pos="-0.22 -2.75 1.6" euler="77.5 0 0" fovy="29"/>
    </worldbody>
</mujoco>